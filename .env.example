# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse Cloud (optional). Without these, runs still write drafts, just no trace.
# Public key starts with pk-lf-, secret key with sk-lf-.
# HOST must match your project's data region: EU is https://cloud.langfuse.com,
# US is https://us.cloud.langfuse.com. Using the wrong region drops every trace.
# PROJECT_ID (Settings -> General) makes the printed trace link open directly.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_ID=...

# Supabase (optional). Without these, runs still write drafts, just no stats row.
# Create a project, run packages/engine/migrations/001_init.sql in the SQL editor,
# then paste the project URL and the service_role key (Settings -> API).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...
