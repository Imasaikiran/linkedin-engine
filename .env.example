# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse Cloud (optional). Without these, runs still write drafts, just no trace.
# Public key starts with pk-lf-, secret key with sk-lf-.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Supabase (optional). Without these, runs still write drafts, just no stats row.
# Create a project, run packages/engine/migrations/001_init.sql in the SQL editor,
# then paste the project URL and the service_role key (Settings -> API).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...
