{
  "name": "linkedin-engine",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "pipeline": "tsx src/agentic-pipeline.ts",
    "pipeline:legacy": "tsx src/legacy-pipeline.ts",
    "pipeline:friday": "tsx src/legacy-pipeline.ts --only fri",
    "stage": "tsx src/cli.ts stage",
    "rerun": "tsx src/cli.ts rerun",
    "voice:refresh": "tsx src/cli.ts voice:refresh",
    "posted": "tsx src/cli.ts posted",
    "draft:freeform": "tsx src/cli.ts draft:freeform",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "dayjs": "^1.11.20",
